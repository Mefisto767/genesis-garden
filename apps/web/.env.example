# Genesis Garden — переменные окружения фронтенда (Vite).
# Скопируй в .env.local (уже в .gitignore) и заполни реальными значениями.
# НИКОГДА не клади сюда service_role key — только публичный anon key,
# он безопасен в клиенте при корректной RLS (см. docs/SECURITY.md).

# URL и anon key твоего Supabase-проекта (Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Фича-флаг: включает облачную синхронизацию аккаунта/прогресса через Supabase
# (Этап 4). Требует также заполненных VITE_SUPABASE_URL/ANON_KEY выше — без них
# синхронизация не активируется, даже если тут true (см. src/lib/supabaseClient.ts).
# Держать false, пока владелец не создаст реальный Supabase-проект и не проверит
# миграцию/RLS на нём вручную — по умолчанию бета работает полностью локально.
VITE_CLOUD_SYNC_ENABLED=false

# Фича-флаг: включает реальный платёжный UI (иначе используется mock-провайдер).
# Держать false в production, пока Paddle sandbox/production не настроен и
# не проверен вручную владельцем (см. docs/PAYMENTS.md).
VITE_PAYMENTS_ENABLED=false

# 'mock' | 'paddle' — какой PaymentProvider использовать на клиенте.
VITE_PAYMENTS_PROVIDER=mock

# Paddle (sandbox) — заполняется, когда у владельца появится аккаунт Paddle.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox

# Аналитика: своего трекера/адаптера для внешнего сервиса (PostHog и т.п.)
# в коде пока нет — все события идут только в Supabase analytics_events
# (см. docs/ANALYTICS.md, честный read-only админ-дашборд поверх этой таблицы).
# Переменные для внешнего сервиса аналитики сюда сознательно не добавлены:
# добавлять их стоит только вместе с реальным адаптером, который их читает,
# а не заранее как заглушку.

# Sentry (опционально) — пусто = сборщик ошибок выключен, приложение работает как обычно.
VITE_SENTRY_DSN=
